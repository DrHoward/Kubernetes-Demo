apiVersion: apps/v1
kind: Deployment
metadata:
  name: reactapp
spec:
  replicas: 3
  selector:
    matchLabels:
      app: reactapp
  template:
    metadata:
      labels:
        app: reactapp
    spec:
      containers:
        - name: reactapp-container
          image: nginx:latest
          ports:
            - containerPort: 80